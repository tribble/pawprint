{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "typeRoots": ["./.pi-types/@types"],
    "paths": {
      "@earendil-works/pi-ai/*": [
        "./.pi-types/@earendil-works/pi-ai/dist/*.d.ts"
      ],
      "@earendil-works/*": [
        "./.pi-types/@earendil-works/*/dist/index.d.ts"
      ],
      "typebox": ["./.pi-types/typebox/build/index.d.mts"]
    }
  },
  "include": ["tests/**/*.ts", "extensions/*.ts"]
}
