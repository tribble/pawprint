{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "extensions/*.ts", "scripts/compare.ts", "scripts/apply-config.ts"]
}
