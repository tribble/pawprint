{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "typeRoots": ["./.pi-types/pi-coding-agent/node_modules/@types"],
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "./.pi-types/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai": [
        "./.pi-types/pi-coding-agent/node_modules/@earendil-works/pi-ai/dist/index.d.ts"
      ],
      "@earendil-works/pi-tui": [
        "./.pi-types/pi-coding-agent/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
      ]
    }
  },
  "include": ["tests/**/*.ts", "pi-agent/extensions/*.ts"]
}
