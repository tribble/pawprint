# pawprint — default-deny: nothing is tracked unless allowlisted below.
# The live ~/.pi is a plain dir; this file is what keeps every checkout's
# tracked surface exact, so runtime files pi writes under agent/ (auth.json,
# sessions/, git/, …) can never become trackable here. Allowlist directories,
# never `agent/**`; agent/bin/ is pi's (fd, rg) and stays ignored: a binary
# dropped there must never become trackable.
*
!.gitignore
!.githooks/
!.githooks/pre-commit
!.gitleaksignore
!README.md
!AGENTS.md
!setup.sh
!scripts/
!scripts/validate.sh
!scripts/sync-forks.sh
!scripts/patch-pi-anthropic-gateway
!scripts/compare.ts
!scripts/apply-config.ts
!manifest.json
!biome.json
!package.json
!tsconfig.json
!mise.toml
!ghostty/
!ghostty/config.ghostty
!extensions/
!extensions/**
!prompts/
!prompts/**
!skills/
!skills/**
!themes/
!themes/**
!tests/
!tests/**
!docs/
!docs/**
!examples/
!examples/**
!agent/
!agent/AGENTS.md
!agent/cloak.json
!agent/mcp.json
!agent/models.json
!agent/presets.json
!agent/settings.json
!agent/agents/
!agent/agents/**
!agent/configs/
!agent/configs/**
*.bak-pawprint-*
