# pawprint — default-deny: nothing is tracked unless allowlisted below.
# pi-agent/ is the curated print; new files dropped there stay invisible
# to git until deliberately allowlisted.
*
!.gitignore
!README.md
!setup.sh
!scripts/
!scripts/sync-back.sh
!scripts/validate.sh
!manifest.json
!package.json
!tsconfig.json
!tests/
!tests/**
!pi-agent/
!pi-agent/**
