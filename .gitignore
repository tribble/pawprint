# pawprint — default-deny: nothing is tracked unless allowlisted below.
# ~/.pi is a sparse worktree of this repo (cone: agent/), so this file is also
# what keeps auth.json, sessions/, git/ and every other runtime file pi writes
# under agent/ invisible to git. Allowlist directories, never `agent/**`;
# agent/bin/ by name: a binary dropped there must never become trackable.
*
!.gitignore
!.githooks/
!.githooks/pre-commit
!.gitleaksignore
!README.md
!AGENTS.md
!setup.sh
!scripts/
!scripts/validate.sh
!scripts/sync-forks.sh
!scripts/patch-pi-anthropic-gateway
!manifest.json
!package.json
!tsconfig.json
!extensions/
!extensions/**
!prompts/
!prompts/**
!skills/
!skills/**
!themes/
!themes/**
!tests/
!tests/**
!agent/
!agent/AGENTS.md
!agent/cloak.json
!agent/mcp.json
!agent/mise.toml
!agent/models.json
!agent/presets.json
!agent/settings.json
!agent/agents/
!agent/agents/**
!agent/bin/
!agent/bin/agent-costs
!agent/configs/
!agent/configs/**
!agent/ghostty/
!agent/ghostty/**
*.bak-pawprint-*
