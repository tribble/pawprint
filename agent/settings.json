{
  "defaultProvider": "cloudflare-ai-gateway",
  "defaultModel": "cloudflare-ai-gateway/gpt-6-astra",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "steeringMode": "all",
  "defaultTools": [
    "+codemode"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "provider": {
      "timeoutMs": 120000
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 64000,
    "keepRecentTokens": 40000
  },
  "enabledModels": [
    "cloudflare-ai-gateway/gpt-6-astra",
    "cloudflare-ai-gateway/claude-opus-5-5",
    "cloudflare-ai-gateway/claude-fable-5-1",
    "cloudflare-ai-gateway/accounts/fireworks/models/kimi-k3",
    "cloudflare-ai-gateway/claude-sonnet-5-5",
    "cloudflare-ai-gateway/accounts/fireworks/models/glm-5p3",
    "cloudflare-ai-gateway/accounts/fireworks/models/deepseek-v4-pro",
    "cloudflare-ai-gateway/accounts/fireworks/models/qwen3p8-max",
    "cloudflare-ai-gateway/accounts/fireworks/models/minimax-m3",
    "cloudflare-ai-gateway/gpt-6.1-sol"
  ],
  "packages": [
    "git:github.com/tribble/pawprint",
    {
      "source": "git:github.com/fitchmultz/pi-fitch-kit@e79bbfeb8fe740cb9394c25c30ea474db3f74d31",
      "extensions": [
        "extensions/anthropic-image-guard.ts",
        "extensions/session-name.ts"
      ],
      "prompts": [
        "prompts/audit/github-open-issues-prs.md"
      ],
      "themes": [
        "themes/calm.json"
      ]
    },
    "git:github.com/fitchmultz/pi-apply-edits@4a05c50cd11c7c2b188fca58ddfbedb1a7590e10",
    "git:github.com/fitchmultz/pi-todo-list@d3574f898ca68e7496bc305da5cabf7f0ad9bff1",
    "git:github.com/fitchmultz/pi-change-working-dir@9731701b62e4888a97bf249b9f52e76447759c2e",
    "git:github.com/fitchmultz/pi-ctx-info@030afef3c93167c0892aa6723e7af8cd62accf60",
    "git:github.com/fitchmultz/pi-tool-duration@4ad8581931f4864634ec72b5b4a4af34958bd071",
    "git:github.com/fitchmultz/pi-edit-session-in-place@1b9a4d9b83757725a736f66f5c1a58557420b5c1",
    "git:github.com/fitchmultz/pi-stash@d1db56e3597018c6d9c6c0b85d1ceb3782bd6bb9",
    "git:github.com/fitchmultz/pi-copy-message@9b3aaf2de125180cf1fe199b0606c6c432d98cb0",
    "git:github.com/fitchmultz/pi-calculator@4cb51c16ed9e47772ac4123f57e234eedd268ed0",
    "git:github.com/fitchmultz/pi-agent-skills@b286c88e3ef164a5c37b8196ab7be0070e53e927",
    "git:github.com/DietrichGebert/ponytail@84740e3d344b69b4a133201fa519eb37a62a2b2a",
    "git:github.com/fitchmultz/pi-agent-browser-native@cb4052d818d7af895b12e28b72f705e918d3b4e2",
    "git:github.com/fitchmultz/pi-subagents@f757ed054e7d819fd590a3da346be8a03aefe2d4",
    "npm:@nicknisi/pi-cloak@0.1.2",
    "npm:@nicknisi/pi-answer@0.2.4"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "cloudflare-ai-gateway/claude-sonnet-5-5",
        "fallbackModels": [
          "openai-codex/gpt-6.1-sol"
        ]
      },
      "context-builder": {
        "model": "cloudflare-ai-gateway/claude-sonnet-5-5",
        "fallbackModels": [
          "anthropic/claude-opus-5-5",
          "openai-codex/gpt-6-astra"
        ]
      },
      "worker": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "thinking": "high"
      },
      "fixer": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "thinking": "low",
        "fallbackModels": false
      },
      "watcher": {
        "model": "cloudflare-ai-gateway/accounts/fireworks/models/minimax-m3"
      },
      "planner": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "thinking": "high",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "oracle": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "thinking": "high",
        "fallbackModels": false
      },
      "debugger": {
        "model": "cloudflare-ai-gateway/gpt-6-astra",
        "thinking": "high",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "researcher": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol"
      },
      "reviewer": {
        "model": "cloudflare-ai-gateway/claude-opus-5-5",
        "thinking": "xhigh",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "reviewer-gpt": {
        "model": "cloudflare-ai-gateway/gpt-6-astra",
        "thinking": "xhigh"
      },
      "reviewer-claude": {
        "model": "cloudflare-ai-gateway/claude-opus-5-5",
        "thinking": "xhigh",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "reviewer-security": {
        "model": "cloudflare-ai-gateway/claude-opus-5-5",
        "thinking": "xhigh",
        "fallbackModels": false
      },
      "reviewer-ponytail": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "fallbackModels": [
          "anthropic/claude-opus-5-5",
          "openai-codex/gpt-6-astra"
        ]
      },
      "ui-designer": {
        "model": "cloudflare-ai-gateway/claude-fable-5-1",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "writer": {
        "model": "cloudflare-ai-gateway/claude-fable-5-1"
      }
    }
  },
  "theme": "gruvbox-tribble",
  "defaultProjectTrust": "ask"
}