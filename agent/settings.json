{
  "defaultProvider": "cloudflare-ai-gateway",
  "defaultModel": "cloudflare-ai-gateway/gpt-6-astra",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "steeringMode": "all",
  "defaultTools": [
    "+codemode"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "provider": {
      "timeoutMs": 120000
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 64000,
    "keepRecentTokens": 40000
  },
  "enabledModels": [
    "cloudflare-ai-gateway/gpt-6-astra",
    "cloudflare-ai-gateway/claude-opus-5-5",
    "cloudflare-ai-gateway/claude-fable-5-1",
    "cloudflare-ai-gateway/accounts/fireworks/models/kimi-k3",
    "cloudflare-ai-gateway/claude-sonnet-5-5",
    "cloudflare-ai-gateway/accounts/fireworks/models/glm-5p3",
    "cloudflare-ai-gateway/accounts/fireworks/models/deepseek-v4-pro",
    "cloudflare-ai-gateway/accounts/fireworks/models/qwen3p8-max",
    "cloudflare-ai-gateway/accounts/fireworks/models/minimax-m3",
    "cloudflare-ai-gateway/gpt-6.1-sol"
  ],
  "packages": [
    "git:github.com/tribble/pawprint",
    {
      "source": "git:github.com/fitchmultz/pi-fitch-kit@3833caf68b83cc9606d2bc8329bca9d09933dafb",
      "extensions": [
        "extensions/anthropic-image-guard.ts",
        "extensions/paged-reader.ts",
        "extensions/session-name.ts"
      ],
      "prompts": [
        "prompts/audit/github-open-issues-prs.md"
      ],
      "themes": [
        "themes/calm.json"
      ]
    },
    "git:github.com/fitchmultz/pi-apply-edits@0a503758ec5de45131546aadf596e6fe56b09670",
    "git:github.com/fitchmultz/pi-todo-list@71db74de6729b326716ba5e2039703cc73f2fede",
    "git:github.com/fitchmultz/pi-change-working-dir@29d0c27564ef02bdc10605f6fa044b953a9bba45",
    "git:github.com/fitchmultz/pi-ctx-info@f26406cfb0e5fc67e09a89e55f7ae6008bf6bcfa",
    "git:github.com/fitchmultz/pi-tool-duration@d1d2dfaaba88820d608155f4a0b94cdc77612c99",
    "git:github.com/fitchmultz/pi-edit-session-in-place@1f1bbba9c9e28bf3b13080626f740ed08c7b14c9",
    "git:github.com/fitchmultz/pi-stash@a2c37d4e995e9e61f8428c8c06fde3f8009f98e6",
    "git:github.com/fitchmultz/pi-copy-message@b6e8a4ca1ad6658bcc552b4ec004326c3ca6cf7c",
    "git:github.com/fitchmultz/pi-calculator@dd71bb78bbf678d3188b8d2f003c933b8043cd8e",
    "git:github.com/fitchmultz/pi-agent-skills@0ad450c5d94212e7b8aaa3c14907e02a6c4387ae",
    "git:github.com/DietrichGebert/ponytail@6c97ffa48710714672214915ad092e3fc6e85516",
    "git:github.com/fitchmultz/pi-agent-browser-native@708dd8ce7ae23971578ad74a418cb4c4319cf2b3",
    "git:github.com/fitchmultz/pi-subagents@22bf049c5f8c167708215c8a34402c03eff84b33",
    "npm:@nicknisi/pi-cloak@0.1.2",
    "npm:@nicknisi/pi-answer@0.2.3"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "cloudflare-ai-gateway/claude-sonnet-5-5",
        "fallbackModels": [
          "openai-codex/gpt-6.1-sol"
        ]
      },
      "context-builder": {
        "model": "cloudflare-ai-gateway/claude-sonnet-5-5",
        "fallbackModels": [
          "anthropic/claude-opus-5-5",
          "openai-codex/gpt-6-astra"
        ]
      },
      "worker": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "thinking": "high"
      },
      "fixer": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "thinking": "low",
        "fallbackModels": false
      },
      "watcher": {
        "model": "cloudflare-ai-gateway/accounts/fireworks/models/minimax-m3"
      },
      "planner": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "thinking": "high",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "oracle": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "thinking": "high"
      },
      "debugger": {
        "model": "cloudflare-ai-gateway/gpt-6-astra",
        "thinking": "high",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "researcher": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol"
      },
      "reviewer": {
        "model": "cloudflare-ai-gateway/claude-opus-5-5",
        "thinking": "xhigh",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "reviewer-gpt": {
        "model": "cloudflare-ai-gateway/gpt-6-astra",
        "thinking": "xhigh"
      },
      "reviewer-claude": {
        "model": "cloudflare-ai-gateway/claude-opus-5-5",
        "thinking": "xhigh",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "reviewer-security": {
        "model": "cloudflare-ai-gateway/claude-opus-5-5",
        "thinking": "xhigh"
      },
      "reviewer-ponytail": {
        "model": "cloudflare-ai-gateway/gpt-6.1-sol",
        "fallbackModels": [
          "anthropic/claude-opus-5-5",
          "openai-codex/gpt-6-astra"
        ]
      },
      "ui-designer": {
        "model": "cloudflare-ai-gateway/claude-fable-5-1",
        "fallbackModels": [
          "anthropic/claude-opus-5-5"
        ]
      },
      "writer": {
        "model": "cloudflare-ai-gateway/claude-fable-5-1"
      }
    },
    "projectTrust": {
      "childRuns": "inherit"
    }
  },
  "theme": "calm-tribble",
  "defaultProjectTrust": "ask"
}