      "scout": {
        "model": "cloudflare-ai-gateway/claude-sonnet-5"
      },
      "context-builder": {
        "model": "cloudflare-ai-gateway/claude-sonnet-5"
      },
      "worker": {
        "model": "cloudflare-ai-gateway/claude-sonnet-5"
      },
      "fixer": {
        "model": "cloudflare-ai-gateway/accounts/fireworks/models/glm-5p3"
      },
      "watcher": {
        "model": "cloudflare-ai-gateway/accounts/fireworks/models/minimax-m3"
      },
      "planner": {
        "model": "cloudflare-ai-gateway/gpt-5.6-sol",
        "thinking": "high"
      },
      "oracle": {
        "model": "cloudflare-ai-gateway/gpt-5.6-sol",
        "thinking": "high"
      },
      "debugger": {
        "model": "cloudflare-ai-gateway/gpt-6-astra",
        "thinking": "high"
      },
      "researcher": {
        "model": "cloudflare-ai-gateway/gpt-5.6-sol"
      },
      "reviewer": {
        "model": "cloudflare-ai-gateway/gpt-6-astra",
        "thinking": "xhigh"
      },
      "reviewer-gpt": {
        "model": "cloudflare-ai-gateway/gpt-6-astra"
      },
      "reviewer-claude": {
        "model": "cloudflare-ai-gateway/claude-opus-5"
      },
      "reviewer-security": {
        "model": "cloudflare-ai-gateway/claude-opus-5",
        "thinking": "xhigh"
      },
      "reviewer-ponytail": {
        "model": "cloudflare-ai-gateway/gpt-5.6-sol"
      },
      "ui-designer": {
        "model": "cloudflare-ai-gateway/claude-fable-5-1"
      },
      "writer": {
        "model": "cloudflare-ai-gateway/claude-fable-5-1"
      }
    },
    "projectTrust": {
      "childRuns": "inherit"
    }
  },
  "lastChangelogVersion": "0.87.1",
  "theme": "calm-tribble",
  "defaultProjectTrust": "ask"
}