# Ghostty config — tuned for herdr-as-cockpit. CANONICAL file.
# (~/.config/ghostty/config is now just a pointer — Ghostty reads XDG first,
# then this macOS path, which wins; one file avoids shadowing.)
# Ghostty is just the pixel pipe: herdr owns layout, splits, persistence,
# and scrollback, so this config stays out of the way.
# Docs: ghostty +show-config --default --docs | less

# --- Appearance ---
# Alternates if Catppuccin ever palls: "Kanagawa Wave", "Gruvbox Dark", "Tokyo Night".
theme = Catppuccin Mocha
font-family = "JetBrainsMono Nerd Font Mono"
font-family = "Hack Nerd Font"
font-thicken = true
font-size = 15

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
macos-titlebar-style = tabs
mouse-hide-while-typing = true
cursor-style = block
unfocused-split-opacity = 0.85

# --- Behavior ---
# herdr's server owns all real work — closing the Ghostty window/surface
# never kills agents, so don't nag about it.
confirm-close-surface = false
quit-after-last-window-closed = true
window-save-state = never
macos-option-as-alt = true
shell-integration = fish
shell-integration-features = cursor,sudo,title
scrollback-limit = 10000

# --- Keybindings ---
keybind = cmd+enter=toggle_fullscreen
macos-non-native-fullscreen = true
keybind = cmd+t=new_tab
keybind = cmd+w=close_tab
keybind = cmd+d=new_split:right
keybind = cmd+shift+=new_split:down
keybind = cmd+]=next_tab
keybind = cmd+[=previous_tab
