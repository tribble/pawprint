{
  "name": "pawprint",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "scripts": {
    "test": "npm run typecheck && node --import ./tests/register.mjs --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "types": "pi_dir=\"$(mise where npm:@earendil-works/pi-coding-agent)\" && ln -sfn \"$pi_dir/node_modules/.mise/node_modules\" .pi-types"
  }
}
