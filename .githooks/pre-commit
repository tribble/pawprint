#!/usr/bin/env bash
# pawprint pre-commit: refuse to commit a secret. Active via
# `git config core.hooksPath .githooks` (setup.sh does it). Fails CLOSED —
# this repo is public, so a missing or broken scanner is a failure, not a skip.
set -uo pipefail

command -v gitleaks >/dev/null 2>&1 || {
  echo "pawprint: gitleaks missing — brew install gitleaks" >&2
  exit 1
}

# A colored diff scans as clean: git's color settings inject ANSI codes into the
# patch gitleaks parses. `-c` (this variable) beats every config source; last wins.
export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }'color.diff=never'"

# gitleaks exits 0 when git itself fails ("0 commits scanned"), so clean means
# exit 0 AND nothing logged at error level.
out=$(gitleaks git --pre-commit --staged --no-banner --no-color --redact -v -l error . 2>&1)
rc=$?
[ "$rc" = 0 ] && [ -z "$out" ] && exit 0
printf '%s\n' "$out" >&2
if [ "$rc" = 0 ]; then
  echo "pawprint: gitleaks could not scan the staged diff (git error above) — fix that, then commit again" >&2
else
  echo "pawprint: secret in staged changes (redacted above) — false positive? add its Fingerprint to .gitleaksignore with a comment, then commit again (never bare --no-verify)" >&2
fi
exit 1
